# =============================================================================
# .env.example - Soteria TACACS+ Server Environment Variables
# =============================================================================
# Company:    Pathfinder Insights
# Engineer:   MotoMotoFan
# Project:    Soteria AAA Infrastructure
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to version control!
# =============================================================================

# =============================================================================
# General Settings
# =============================================================================

# Timezone for all containers (e.g. America/Sao_Paulo, Europe/London, UTC)
# Run 'timedatectl list-timezones' on the host to see available options
TZ=UTC

# =============================================================================
# TACACS+ Settings
# =============================================================================

# Shared secret key for TACACS+ communication with network devices
TACACS_KEY=

# Host port to expose TACACS+ on (default: 49)
TACACS_LISTEN_PORT=49

# Seed local users (fallback + service accounts) - SHA-512 crypt hashes.
# These are injected into 05-local-users.cfg at first deploy. Generate with:
#   openssl passwd -6 'yourpassword'
# install.sh will prompt for plaintext passwords and fill these in for you.
# NEVER commit real hashes; keep them only in .env (gitignored).
LOCAL_ADMIN_PW_HASH=
LOCAL_READONLY_PW_HASH=

# =============================================================================
# DNS Settings
# =============================================================================

# Primary DNS server for reverse lookups (optional)
DNS_SERVER_IP_01=

# =============================================================================
# LDAP / Active Directory Settings (optional)
# =============================================================================
# By default, Soteria uses local authentication only (05-local-users.cfg).
# Set ENABLE_LDAP=true to activate the MAVIS/LDAP backend.
# When enabled, all LDAP_* variables below become required.
# =============================================================================

# Enable LDAP/AD authentication backend (true/false)
ENABLE_LDAP=false

# LDAP server type: "microsoft" (Active Directory) or "generic" (OpenLDAP)
LDAP_SERVER_TYPE=microsoft

# LDAP server(s) - space-separated for failover
# Example: "ldaps://dc01.domain.local ldaps://dc02.domain.local"
LDAP_HOSTS=

# LDAP bind credentials (service account)
LDAP_USER=
LDAP_PASSWD=

# User search base and scope
# Example base: "DC=domain,DC=local"
LDAP_BASE=
LDAP_SCOPE=sub

# User search filter
# Default for AD: (&(objectClass=user)(sAMAccountName=%s)(memberOf=CN=tacacs_users,OU=Groups,DC=domain,DC=local))
LDAP_FILTER=(&(objectClass=user)(sAMAccountName=%s))

# Group search base and scope
# Example: "OU=TACACS,OU=Groups,DC=domain,DC=local"
LDAP_BASE_GROUP=
LDAP_SCOPE_GROUP=sub

# Group search filter
# Default for AD: (&(objectClass=group)(member=%s))
LDAP_FILTER_GROUP=(&(objectClass=group)(member=%s))

# LDAP connection timeout in seconds
LDAP_CONNECT_TIMEOUT=5

# LDAP attribute containing TACACS+ group membership
LDAP_TACMEMBER=memberOf

# =============================================================================
# TLS Settings
# =============================================================================

# Enable TACACS+ over TLS on port 300 (true/false)
# When enabled, mount certificates to ./tls/ directory:
#   server.crt  - Server certificate (PEM)
#   server.key  - Server private key (PEM)
#   ca.crt      - Certificate Authority chain (PEM)
ENABLE_TLS=false

# Host port to expose TACACS+ TLS on (default: 300, IANA assigned)
TACACS_TLS_PORT=300

# =============================================================================
# Cron / Maintenance Settings
# =============================================================================

# Enable weekly logrotate for process log (true/false)
ENABLE_LOGROTATE=true

# Enable monthly AAA log archiving (true/false)
# Set to false if shipping logs to an external syslog collector
ENABLE_MONTHLY_ARCHIVE=true
