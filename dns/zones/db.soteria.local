$TTL 3600
@       IN  SOA ns.soteria.local. admin.soteria.local. (
                2026070705 ; Serial (managed by soteria-agent)
                3600       ; Refresh
                1800       ; Retry
                604800     ; Expire
                300 )      ; Negative cache TTL

@              IN  NS  ns.soteria.local.
agent          IN  A   192.168.1.160
network-tools  IN  A   192.168.1.160
nginx          IN  A   192.168.1.160
ns             IN  A   192.168.1.160
openbao        IN  A   192.168.1.160
supabase       IN  A   192.168.1.160
tacacs         IN  A   192.168.1.160
wazuh          IN  A   192.168.1.154
