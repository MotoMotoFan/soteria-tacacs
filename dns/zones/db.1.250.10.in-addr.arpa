$TTL 3600
@       IN  SOA ns.soteria.local. admin.soteria.local. (
                2026071003 ; Serial (managed by soteria-agent)
                3600       ; Refresh
                1800       ; Retry
                604800     ; Expire
                300 )      ; Negative cache TTL

@   IN  NS   ns.soteria.local.
1   IN  PTR  SPINE.01.
2   IN  PTR  SPINE.02.
3   IN  PTR  BDR.LEAF.01.
4   IN  PTR  BDR.LEAF.02.
11  IN  PTR  LEAF.01.
12  IN  PTR  LEAF.02.
