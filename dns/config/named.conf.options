options {
    directory "/var/cache/bind";

    // Authoritative for the lab zones + recursive resolver for LAN clients
    // (lab PCs point their DNS at this server, so it must also resolve
    // internet names like the Cloudflare tunnel hostname).
    recursion yes;
    allow-query { any; };
    allow-recursion { 127.0.0.1; 192.168.1.0/24; 10.250.0.0/16; };
    forwarders { 1.1.1.1; 8.8.8.8; };
    allow-transfer { none; };

    // Forwarders do the validation; keep it off locally to avoid breakage
    // behind the lab network.
    dnssec-validation no;

    // We serve a specific RFC1918 reverse zone; don't let BIND's automatic
    // empty zones shadow it.
    empty-zones-enable no;

    listen-on { any; };
    listen-on-v6 { none; };
};
