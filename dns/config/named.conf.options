options {
    directory "/var/cache/bind";

    // Authoritative only: never resolve names we are not master for.
    recursion no;
    allow-query { any; };
    allow-transfer { none; };

    // Without recursion there is no upstream to validate against.
    dnssec-validation no;

    // We serve a specific RFC1918 reverse zone; don't let BIND's automatic
    // empty zones shadow it.
    empty-zones-enable no;

    listen-on { any; };
    listen-on-v6 { none; };
};
