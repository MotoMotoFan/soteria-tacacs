# =============================================================================
# Soteria Frontend nginx site - serves the SPA and proxies the backends.
# Replicates the Vite dev-server proxy (see frontend/vite.config.ts) so the
# browser/phone uses ONE origin (no CORS, no mixed content over the tunnel).
# Upstreams come from env (envsubst): AGENT_UPSTREAM, SUPABASE_UPSTREAM,
# KEYCLOAK_UPSTREAM. Put a TLS-terminating reverse proxy (nginx/Cloudflare) in
# front of this in production.
#
# Upstream hostnames are resolved LAZILY via Docker's embedded DNS (127.0.0.11)
# through variable proxy_pass: a literal proxy_pass hostname is resolved at
# config load, so nginx would refuse to start when an optional dependency
# (kong/keycloak) is not on the network yet. With variables the frontend always
# starts; an absent backend answers 502 instead of taking the whole UI down.
# =============================================================================

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    resolver 127.0.0.11 valid=30s ipv6=off;
    set $agent_upstream    "${AGENT_UPSTREAM}";
    set $supabase_upstream "${SUPABASE_UPSTREAM}";
    set $keycloak_upstream "${KEYCLOAK_UPSTREAM}";

    # Mobile connection discovery (emitted into the build). Always fresh so the
    # anon key can be rotated centrally.
    location = /connect-info.json {
        add_header Cache-Control "no-store" always;
        try_files /connect-info.json =404;
    }

    # Soteria agent REST API.
    location /agent/ {
        rewrite ^/agent(/.*)$ $1 break;
        proxy_pass http://$agent_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;   # commit / tools / dns scans can be slow
    }

    # Self-hosted Supabase (Kong gateway). WebSocket upgrade for realtime.
    location /supabase/ {
        rewrite ^/supabase(/.*)$ $1 break;
        proxy_pass http://$supabase_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Keycloak IdP for OIDC/SSO. Serves under /keycloak (KC_HTTP_RELATIVE_PATH),
    # so the original URI is forwarded unchanged; the real host/proto headers let
    # it build correct public URLs.
    location /keycloak/ {
        proxy_pass http://$keycloak_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # SPA fallback (client-side routing).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Long-cache the hashed assets; never cache index.html.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }
    location = /index.html {
        add_header Cache-Control "no-store" always;
    }
}
