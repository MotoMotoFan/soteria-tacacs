# Supabase connection for the Soteria web UI.
# Copy to .env.local and fill in — actual values are stored in OpenBao
# (https://openbao.lab.home) under the soteria-app engine, path: supabase.
VITE_SUPABASE_URL=https://supabase.lab.home
VITE_SUPABASE_ANON_KEY=
# Lab/testing only: enables the Web UI Users management section in Settings.
# Never ship a service_role key in a real frontend build.
VITE_SUPABASE_SERVICE_ROLE_KEY=

# soteria-agent management API (the TACACS+ backend for all entity pages).
# Lab: the agent container on the test server, port 8081.
VITE_AGENT_URL=http://192.168.1.160:8081
