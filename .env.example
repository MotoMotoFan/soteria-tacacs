# =============================================================================
# .env.example - Soteria TACACS+ full stack
# =============================================================================
# Company:    Pathfinder Insights
# Engineer:   MotoMotoFan
# Project:    Soteria AAA Infrastructure
# =============================================================================
# Copy to .env and fill in.  ./install.sh will generate the secrets for you.
# NEVER commit .env (it is gitignored). Real secrets stay out of the repo.
# =============================================================================

# ---- General ----------------------------------------------------------------
TZ=UTC

# ---- TACACS+ (tac_plus-ng) --------------------------------------------------
# Shared secret used by network devices to talk to the TACACS+ server.
TACACS_KEY=
TACACS_LISTEN_PORT=49
TACACS_TLS_PORT=300
ENABLE_TLS=false

# Seed local users - SHA-512 crypt hashes injected into 05-local-users.cfg.
# Generate:  openssl passwd -6 'yourpassword'   (install.sh prompts for these)
# NOTE: docker compose interpolates $ in .env values - every literal $ in a
# hash MUST be written as $$ (install.sh does this for you).
LOCAL_ADMIN_PW_HASH=
LOCAL_READONLY_PW_HASH=

# ---- Agent (management API) -------------------------------------------------
AGENT_LISTEN_PORT=8081
# JWT verification for the Supabase user tokens the agent trusts. Set the JWKS
# URL (modern ES256) OR the shared secret (HS256). Leave both empty for lab
# no-auth (NOT for production).
AGENT_JWKS_URL=
AGENT_JWT_SECRET=
# Config backup retention (number of snapshots kept).
AGENT_BACKUP_RETAIN=5
# NetBox (DNS source-of-truth scans) - optional.
AGENT_NETBOX_URL=
AGENT_NETBOX_HOST=
AGENT_NETBOX_TOKEN=
AGENT_NETBOX_INSECURE=false

# ---- DNS (BIND9) ------------------------------------------------------------
DNS_LISTEN_ADDR=0.0.0.0
DNS_SERVER_IP_01=

# ---- Frontend (build-time public config) ------------------------------------
# Relative proxy paths (served same-origin by the frontend nginx) + PUBLIC anon
# key (safe to embed). The build also emits /connect-info.json for the apps.
VITE_AGENT_URL=/agent
VITE_SUPABASE_URL=/supabase
VITE_SUPABASE_ANON_KEY=
# LAB ONLY: bakes the service role key into the browser bundle so the Settings
# admin sections (Web UI Users / Access Groups) work without a backend. This is
# a root credential - leave EMPTY outside a disposable test lab.
VITE_SUPABASE_SERVICE_ROLE_KEY=

# ---- Frontend (runtime proxy upstreams on soteria-net) ----------------------
AGENT_UPSTREAM=soteria-agent:8081
SUPABASE_UPSTREAM=kong:8000
KEYCLOAK_UPSTREAM=keycloak:8080

# ---- LDAP / Active Directory (optional; tac_plus-ng MAVIS backend) -----------
# When ENABLE_LDAP=true, all LDAP_* below are required (see docs/configuration.md).
ENABLE_LDAP=false
LDAP_SERVER_TYPE=microsoft
LDAP_HOSTS=
LDAP_USER=
LDAP_PASSWD=
LDAP_BASE=
LDAP_SCOPE=sub
LDAP_FILTER=(&(objectClass=user)(sAMAccountName=%s))
LDAP_BASE_GROUP=
LDAP_SCOPE_GROUP=sub
LDAP_FILTER_GROUP=(&(objectClass=group)(member=%s))
LDAP_CONNECT_TIMEOUT=5
LDAP_TACMEMBER=memberOf

# ---- Maintenance ------------------------------------------------------------
ENABLE_LOGROTATE=true
ENABLE_MONTHLY_ARCHIVE=true

# ---- Dependencies (set up separately; see docs/dependencies.md) -------------
# Supabase, Keycloak and OpenBao are stood up by install.sh from upstream on the
# same soteria-net. Their own secrets live in their own env files, NOT here.
